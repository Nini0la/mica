APP_ENV=development
DATABASE_URL=postgresql+psycopg://continuity:continuity@localhost:5432/continuity
ACCESS_CODE=replace-with-a-long-random-code
SESSION_SECRET=replace-with-at-least-32-random-characters
ALLOWED_ORIGINS=http://localhost:3000
MODEL_MODE=deterministic
# To enable real contextual conversation, use MODEL_MODE=live and configure all three:
# MODEL_BASE_URL=https://your-openai-compatible-provider.example/v1
# MODEL_API_KEY=your-server-side-key
# MODEL_NAME=your-tool-capable-model
PROVIDER=openai_compatible
# Azure alternative: set PROVIDER=azure_openai and MODEL_MODE=live.
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_KEY=your-server-side-key
# AZURE_OPENAI_DEPLOYMENT=your-deployment-name
# AZURE_OPENAI_API_VERSION=2024-10-21
# Alternatively reference a local server-only dotenv file containing those four Azure settings:
# AZURE_OPENAI_CONFIG_FILE=/absolute/path/to/existing/.env
# Nebius Token Factory: set PROVIDER=nebius and MODEL_MODE=live.
# NEBIUS_API_KEY=your-server-side-nebius-key
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Explicit model selection; verify availability for your account before live use.
# NEBIUS_MODEL=nvidia/Nemotron-3.5-Super-VL
# Optional model-supported reasoning control; does not inherit MODEL_REASONING_EFFORT.
# NEBIUS_REASONING_EFFORT=low
# Optional Nebius-specific USD per million tokens (never inherit Azure prices):
# NEBIUS_INPUT_COST_PER_MILLION=0.00
# NEBIUS_OUTPUT_COST_PER_MILLION=0.00
# Optional for deployments supporting reasoning controls (e.g. GPT-5.4):
# MODEL_REASONING_EFFORT=none
MODEL_MAX_OUTPUT_TOKENS=600
MODEL_TIMEOUT_SECONDS=15
# Optional USD per million tokens; omit unknown prices (cost remains unknown, not zero).
# MODEL_INPUT_COST_PER_MILLION=0.00
# MODEL_OUTPUT_COST_PER_MILLION=0.00
NEXT_PUBLIC_API_URL=http://localhost:8000

# Operational responsibilities: register the dedicated assistant number in Today first.
# `uv run python -m app.configure_operations --account-id <id>` writes these locally.
# CHANNEL_ACCOUNT_ID=registered-channel-uuid
# CHANNEL_BRIDGE_TOKEN=replace-with-a-random-secret-at-least-32-characters
# CHANNEL_BRIDGE_URL=http://127.0.0.1:8081
# CHANNEL_BRIDGE_PORT=8081
# CORE_API_URL=http://127.0.0.1:8000
# WHATSAPP_ASSISTANT_NUMBER=+441234567890
# WHATSAPP_STATE_PATH=/absolute/private/path/whatsapp.db
TELEGRAM_BOT_TOKEN=

# Optional goal-aware web research; only explicit conversational research invokes it.
# TAVILY_API_KEY=your-server-side-tavily-key
# MICA_RESEARCH_DAILY_LIMIT=60
